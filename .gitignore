# The narration ships in the repo so GitHub Pages serves the same narrated
# edition as here.now. Only the finished per-chapter renders -- the scratch
# clips cut while tuning the voice (smooth_*, *_options, dashfix_*) stay local.
audio/*
!audio/Preface.mp3
!audio/Preface.json
!audio/Chapter_*.mp3
!audio/Chapter_*.json
# webbook build's own audio naming (ch{N}.mp3/.json, foreword-offset copies
# of the files above) -- ships alongside them, same bytes under a new name.
!audio/ch*.mp3
!audio/ch*.json
verdicts.json
proposals.*
.review-cert/

# narration verification: run artefacts, regenerable from the audio
verify/
confirm/
narration_review.html
*.log
rare_report.*
rare_terms.json
term_counts.json
.claude/

